<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backups. Settings hold the leaderboard API token, which
    shouldn't leave the phone in a cloud backup or a device-to-device copy;
    the play log itself is fine to carry over. On a new phone the account
    comes back with its recovery code.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
