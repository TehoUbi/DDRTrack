rules_version = '2';

// Each player (an anonymous Firebase Auth user) can read and write only
// their own tree. Nothing is shared through Firestore: cross-player
// comparison goes through the leaderboard server.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /plays/{playId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.score is int
          && request.resource.data.score >= 0 && request.resource.data.score <= 1000000
          && request.resource.data.level is int
          && request.resource.data.level >= 1 && request.resource.data.level <= 19
          && request.resource.data.updatedAt is int
          && request.resource.data.deleted is bool;
      }

      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
